{
  "schemaVersion": 1,
  "screenId": "home",
  "theme": "light",
  "initialState": {
    "topTab": "all",
    "carsFilter": "recent",
    "emiTenure": "60"
  },
  "sheets": {
    "emi_breakup": {
      "id": "sheet_emi",
      "type": "column",
      "style": {
        "padding": {
          "start": 20,
          "top": 20,
          "end": 20,
          "bottom": 32
        }
      },
      "children": [
        {
          "id": "emi_t",
          "type": "text",
          "props": {
            "text": "EMI breakup",
            "variant": "title"
          }
        },
        {
          "id": "emi_tenure",
          "type": "chip_row",
          "props": {
            "stateKey": "emiTenure",
            "variant": "pill",
            "textColor": "text.primary",
            "chips": [
              {
                "id": "12",
                "label": "12 mo"
              },
              {
                "id": "24",
                "label": "24 mo"
              },
              {
                "id": "36",
                "label": "36 mo"
              },
              {
                "id": "48",
                "label": "48 mo"
              },
              {
                "id": "60",
                "label": "60 mo"
              }
            ],
            "width": "fill"
          },
          "actions": {
            "onSelect": {
              "type": "set_state",
              "payload": {
                "key": "emiTenure",
                "value": "@{chip.id}"
              }
            }
          }
        },
        {
          "id": "emi_amt_12",
          "type": "column",
          "visibleWhen": {
            "state": "emiTenure",
            "equals": "12"
          },
          "children": [
            {
              "id": "emi_c_12",
              "type": "text",
              "props": {
                "text": "₹37,220 / month",
                "variant": "heading"
              }
            },
            {
              "id": "emi_s_12",
              "type": "text",
              "props": {
                "text": "Down payment ₹1,04,200 · 12 months · 12.5% p.a.",
                "variant": "caption"
              }
            }
          ]
        },
        {
          "id": "emi_amt_24",
          "type": "column",
          "visibleWhen": {
            "state": "emiTenure",
            "equals": "24"
          },
          "children": [
            {
              "id": "emi_c_24",
              "type": "text",
              "props": {
                "text": "₹19,540 / month",
                "variant": "heading"
              }
            },
            {
              "id": "emi_s_24",
              "type": "text",
              "props": {
                "text": "Down payment ₹1,04,200 · 24 months · 12.5% p.a.",
                "variant": "caption"
              }
            }
          ]
        },
        {
          "id": "emi_amt_36",
          "type": "column",
          "visibleWhen": {
            "state": "emiTenure",
            "equals": "36"
          },
          "children": [
            {
              "id": "emi_c_36",
              "type": "text",
              "props": {
                "text": "₹13,780 / month",
                "variant": "heading"
              }
            },
            {
              "id": "emi_s_36",
              "type": "text",
              "props": {
                "text": "Down payment ₹1,04,200 · 36 months · 12.5% p.a.",
                "variant": "caption"
              }
            }
          ]
        },
        {
          "id": "emi_amt_48",
          "type": "column",
          "visibleWhen": {
            "state": "emiTenure",
            "equals": "48"
          },
          "children": [
            {
              "id": "emi_c_48",
              "type": "text",
              "props": {
                "text": "₹12,150 / month",
                "variant": "heading"
              }
            },
            {
              "id": "emi_s_48",
              "type": "text",
              "props": {
                "text": "Down payment ₹1,04,200 · 48 months · 12.5% p.a.",
                "variant": "caption"
              }
            }
          ]
        },
        {
          "id": "emi_amt_60",
          "type": "column",
          "visibleWhen": {
            "state": "emiTenure",
            "equals": "60"
          },
          "children": [
            {
              "id": "emi_c_60",
              "type": "text",
              "props": {
                "text": "₹11,598 / month",
                "variant": "heading"
              }
            },
            {
              "id": "emi_s_60",
              "type": "text",
              "props": {
                "text": "Down payment ₹1,04,200 · 60 months · 12.5% p.a.",
                "variant": "caption"
              }
            }
          ]
        },
        {
          "id": "emi_d",
          "type": "text",
          "props": {
            "text": "*Indicative. Final EMI depends on lender approval.",
            "variant": "caption"
          }
        },
        {
          "id": "emi_cta",
          "type": "button",
          "props": {
            "label": "Got it",
            "variant": "primary"
          },
          "actions": {
            "onClick": {
              "type": "sequence",
              "actions": [
                {
                  "type": "track",
                  "payload": {
                    "event": "emi_sheet_dismiss"
                  }
                },
                {
                  "type": "dismiss",
                  "payload": {}
                }
              ]
            }
          }
        }
      ]
    }
  },
  "root": {
    "id": "root",
    "type": "column",
    "children": [
      {
        "id": "header",
        "type": "header",
        "style": {
          "bg": "surface.brand",
          "padding": {
            "start": 16,
            "top": 12,
            "end": 16,
            "bottom": 8
          }
        },
        "props": {
          "location": "Ahmedabad",
          "avatarInitials": "CG",
          "searchHint": "Search Baleno"
        },
        "actions": {
          "onLocationClick": {
            "type": "navigate",
            "payload": {
              "route": "city_picker"
            }
          },
          "onSearchClick": {
            "type": "navigate",
            "payload": {
              "route": "search"
            }
          },
          "onAvatarClick": {
            "type": "navigate",
            "payload": {
              "route": "profile"
            }
          }
        }
      },
      {
        "id": "top_tabs",
        "type": "chip_row",
        "style": {
          "bg": "surface.brand",
          "padding": {
            "start": 8,
            "top": 4,
            "end": 8,
            "bottom": 12
          }
        },
        "props": {
          "stateKey": "topTab",
          "variant": "icon_circle",
          "chips": [
            {
              "id": "all",
              "label": "All",
              "imageUrl": "file:///android_asset/images/ic_all.png"
            },
            {
              "id": "buy",
              "label": "Buy used car",
              "imageUrl": "file:///android_asset/images/ic_buy.png"
            },
            {
              "id": "sell",
              "label": "Sell car",
              "imageUrl": "file:///android_asset/images/ic_sell.png"
            },
            {
              "id": "loan",
              "label": "Loans",
              "imageUrl": "file:///android_asset/images/ic_loan.png"
            }
          ],
          "width": "fill"
        },
        "actions": {
          "onSelect": {
            "type": "sequence",
            "actions": [
              {
                "type": "set_state",
                "payload": {
                  "key": "topTab",
                  "value": "@{chip.id}"
                }
              },
              {
                "type": "track",
                "payload": {
                  "event": "top_tab_select",
                  "id": "@{chip.id}"
                }
              }
            ]
          }
        }
      },
      {
        "id": "hero_recent",
        "type": "hero_card",
        "visibleWhen": {
          "state": "topTab",
          "in": [
            "all",
            "buy"
          ]
        },
        "style": {
          "bg": "surface.brand",
          "padding": {
            "start": 16,
            "top": 0,
            "end": 16,
            "bottom": 20
          }
        },
        "props": {
          "variant": "split",
          "eyebrow": "BUY USED CAR",
          "title": "High demand for the car you viewed · 2016 Creta",
          "subtitle": "Inspected · Certified · Best Price",
          "imageUrl": "https://images.pexels.com/photos/28673504/pexels-photo-28673504.jpeg",
          "priceBadge": "₹ 5.21 Lakh",
          "priceAlign": "center",
          "tags": [
            "72,971 km",
            "Petrol",
            "Manual"
          ],
          "cta": {
            "label": "Book FREE test drive",
            "style": "arrow"
          }
        },
        "actions": {
          "onCtaClick": {
            "type": "navigate",
            "payload": {
              "route": "test_drive",
              "params": {
                "carId": "creta2016"
              }
            }
          }
        }
      },
      {
        "id": "sec_buy",
        "type": "section",
        "visibleWhen": {
          "state": "topTab",
          "in": [
            "all",
            "buy"
          ]
        },
        "style": {
          "bg": "surface.default",
          "padding": {
            "start": 0,
            "top": 20,
            "end": 0,
            "bottom": 4
          }
        },
        "props": {
          "title": "Buy car",
          "titleStyle": {
            "size": 20,
            "bold": true
          },
          "badge": {
            "text": "Up to ₹80,000 off",
            "bg": "#E5271B",
            "textColor": "#FFFFFF"
          }
        },
        "children": [
          {
            "id": "buy_rail",
            "type": "lazy_row",
            "style": {
              "padding": {
                "start": 20,
                "top": 12,
                "end": 20,
                "bottom": 0
              },
              "itemSpacing": 12
            },
            "template": {
              "type": "image_tile",
              "props": {
                "title": "@{item.title}",
                "imageUrl": "https://placehold.net/8.png",
                "imageFill": true,
                "titleStyle": {
                  "color": "text.onBrand",
                  "size": 18,
                  "bold": true,
                  "position": "top_start"
                },
                "width": 160,
                "height": 120
              },
              "actions": {
                "onClick": {
                  "type": "navigate",
                  "payload": {
                    "route": "listing",
                    "params": {
                      "type": "@{item.filterType}"
                    }
                  }
                }
              }
            },
            "items": [
              {
                "id": "t_all",
                "title": "All used cars",
                "filterType": "all"
              },
              {
                "id": "t_budget",
                "title": "Budget used cars",
                "filterType": "budget"
              },
              {
                "id": "t_premium",
                "title": "Premium used cars",
                "filterType": "premium"
              },
              {
                "id": "t_new",
                "title": "New cars",
                "filterType": "new"
              }
            ]
          }
        ]
      },
      {
        "id": "sec_sell",
        "type": "section",
        "visibleWhen": {
          "state": "topTab",
          "in": [
            "all",
            "sell"
          ]
        },
        "style": {
          "bg": "surface.default",
          "padding": {
            "start": 0,
            "top": 20,
            "end": 0,
            "bottom": 4
          }
        },
        "props": {
          "title": "Sell your car",
          "titleStyle": {
            "size": 20,
            "bold": true
          }
        },
        "children": [
          {
            "id": "sell_rail",
            "type": "lazy_row",
            "style": {
              "padding": {
                "start": 20,
                "top": 12,
                "end": 20,
                "bottom": 0
              },
              "itemSpacing": 12
            },
            "template": {
              "type": "image_tile",
              "props": {
                "title": "@{item.title}",
                "imageUrl": "https://placehold.net/5.png",
                "imageFill": true,
                "titleStyle": {
                  "color": "text.onBrand",
                  "size": 18,
                  "bold": true,
                  "position": "top_start"
                },
                "width": 160,
                "height": 120
              },
              "actions": {
                "onClick": {
                  "type": "navigate",
                  "payload": {
                    "route": "@{item.route}"
                  }
                }
              }
            },
            "items": [
              {
                "id": "s_sell",
                "title": "Sell your car",
                "route": "sell_flow"
              },
              {
                "id": "s_valuation",
                "title": "Check car valuation",
                "route": "valuation"
              },
              {
                "id": "s_scrap",
                "title": "Scrap your car",
                "route": "scrap"
              }
            ]
          }
        ]
      },
      {
        "id": "sec_loans",
        "type": "section",
        "visibleWhen": {
          "state": "topTab",
          "notIn": [
            "buy",
            "sell"
          ]
        },
        "style": {
          "bg": "surface.default",
          "padding": {
            "start": 0,
            "top": 20,
            "end": 0,
            "bottom": 4
          }
        },
        "props": {
          "title": "Get loans",
          "titleStyle": {
            "size": 20,
            "bold": true
          }
        },
        "children": [
          {
            "id": "loan_rail",
            "type": "lazy_row",
            "style": {
              "padding": {
                "start": 20,
                "top": 12,
                "end": 20,
                "bottom": 0
              },
              "itemSpacing": 16
            },
            "template": {
              "type": "image_tile",
              "props": {
                "title": "@{item.title}",
                "imageUrl": "https://placehold.net/7.png",
                "imageFill": true,
                "titleStyle": {
                  "color": "text.primary",
                  "position": "below"
                },
                "width": 120,
                "height": 96
              },
              "actions": {
                "onClick": {
                  "type": "navigate",
                  "payload": {
                    "route": "loan",
                    "params": {
                      "type": "@{item.loanType}"
                    }
                  }
                }
              }
            },
            "items": [
              {
                "id": "l_used",
                "title": "Used car loan",
                "loanType": "used"
              },
              {
                "id": "l_against",
                "title": "Loan against car",
                "loanType": "against"
              },
              {
                "id": "l_personal",
                "title": "Personal loan",
                "loanType": "personal"
              }
            ]
          }
        ]
      },
      {
        "id": "sec_checks",
        "type": "section",
        "style": {
          "bg": "surface.default",
          "padding": {
            "start": 0,
            "top": 24,
            "end": 0,
            "bottom": 4
          }
        },
        "props": {
          "title": "Car check services",
          "titleStyle": {
            "size": 20,
            "bold": true
          }
        },
        "children": [
          {
            "id": "checks_grid",
            "type": "grid",
            "style": {
              "padding": {
                "start": 20,
                "top": 12,
                "end": 20,
                "bottom": 0
              },
              "itemSpacing": 12
            },
            "props": {
              "columns": 3
            },
            "template": {
              "type": "icon_card",
              "props": {
                "title": "@{item.title}",
                "imageUrl": "@{item.imageUrl}",
                "width": "content"
              },
              "actions": {
                "onClick": {
                  "type": "navigate",
                  "payload": {
                    "route": "service",
                    "params": {
                      "id": "@{item.serviceId}"
                    }
                  }
                }
              }
            },
            "items": [
              {
                "id": "g_pdi",
                "title": "New car PDI",
                "imageUrl": "file:///android_asset/images/ic_pdi.png",
                "serviceId": "pdi"
              },
              {
                "id": "g_check",
                "title": "Used car check",
                "imageUrl": "file:///android_asset/images/ic_check.png",
                "serviceId": "check"
              },
              {
                "id": "g_history",
                "title": "Vehicle history",
                "imageUrl": "file:///android_asset/images/ic_history.png",
                "serviceId": "history"
              },
              {
                "id": "g_challan",
                "title": "Check challan",
                "imageUrl": "file:///android_asset/images/ic_challan.png",
                "serviceId": "challan"
              },
              {
                "id": "g_ins",
                "title": "Check car insurance",
                "imageUrl": "file:///android_asset/images/ic_insurance.png",
                "serviceId": "insurance"
              },
              {
                "id": "g_odo",
                "title": "Odometer tampering",
                "imageUrl": "file:///android_asset/images/ic_odometer.png",
                "serviceId": "odometer"
              }
            ]
          }
        ]
      },
      {
        "id": "sec_love",
        "type": "section",
        "style": {
          "bg": "surface.default",
          "padding": {
            "start": 0,
            "top": 24,
            "end": 0,
            "bottom": 4
          }
        },
        "props": {
          "title": "Used cars you'll love",
          "titleStyle": {
            "size": 20,
            "bold": true
          },
          "trailing": {
            "label": "View all"
          }
        },
        "actions": {
          "onTrailingClick": {
            "type": "navigate",
            "payload": {
              "route": "listing",
              "params": {
                "source": "love"
              }
            }
          }
        },
        "children": [
          {
            "id": "love_filter",
            "type": "chip_row",
            "style": {
              "padding": {
                "start": 20,
                "top": 12,
                "end": 20,
                "bottom": 0
              },
              "itemSpacing": 8
            },
            "props": {
              "stateKey": "carsFilter",
              "variant": "pill",
              "chips": [
                {
                  "id": "recent",
                  "label": "Recently viewed"
                },
                {
                  "id": "hot",
                  "label": "Hot deals"
                }
              ],
              "width": "fill",
              "textColor": "text.primary"
            },
            "actions": {
              "onSelect": {
                "type": "set_state",
                "payload": {
                  "key": "carsFilter",
                  "value": "@{chip.id}"
                }
              }
            }
          },
          {
            "id": "love_rail_recent",
            "type": "lazy_row",
            "visibleWhen": {
              "state": "carsFilter",
              "notEquals": "hot"
            },
            "style": {
              "padding": {
                "start": 20,
                "top": 12,
                "end": 20,
                "bottom": 0
              },
              "itemSpacing": 12
            },
            "template": {
              "type": "car_card",
              "props": {
                "imageUrl": "@{item.imageUrl}",
                "assuredLabel": "@{item.assuredLabel}",
                "name": "@{item.name}",
                "variant": "@{item.variant}",
                "specs": "@{item.specs}",
                "price": "@{item.price}",
                "priceValue": "@{item.priceValue}",
                "emi": "@{item.emi}",
                "footnote": "@{item.footnote}",
                "badges": "@{item.badges}",
                "wishlisted": "@{item.wishlisted}",
                "stateKey": "wishlist_@{item.carId}"
              },
              "actions": {
                "onClick": {
                  "type": "sequence",
                  "actions": [
                    {
                      "type": "track",
                      "payload": {
                        "event": "car_click",
                        "id": "@{item.carId}"
                      }
                    },
                    {
                      "type": "navigate",
                      "payload": {
                        "route": "car_detail",
                        "params": {
                          "carId": "@{item.carId}"
                        }
                      }
                    }
                  ]
                },
                "onEmiClick": {
                  "type": "open_sheet",
                  "payload": {
                    "sheetId": "emi_breakup"
                  }
                },
                "onWishlistSelect": {
                  "type": "sequence",
                  "actions": [
                    {
                      "type": "track",
                      "payload": {
                        "event": "wishlist_add",
                        "id": "@{item.carId}"
                      }
                    },
                    {
                      "type": "set_state",
                      "payload": {
                        "key": "wishlist_@{item.carId}",
                        "value": "true"
                      }
                    },
                    {
                      "type": "show_snackbar",
                      "payload": {
                        "message": "Car added to favourite list"
                      }
                    }
                  ]
                },
                "onWishlistUnselect": {
                  "type": "sequence",
                  "actions": [
                    {
                      "type": "track",
                      "payload": {
                        "event": "wishlist_remove",
                        "id": "@{item.carId}"
                      }
                    },
                    {
                      "type": "set_state",
                      "payload": {
                        "key": "wishlist_@{item.carId}",
                        "value": "false"
                      }
                    },
                    {
                      "type": "show_snackbar",
                      "payload": {
                        "message": "Car removed from favourite list"
                      }
                    }
                  ]
                }
              }
            },
            "items": [
              {
                "id": "car_creta",
                "imageUrl": "https://images.pexels.com/photos/25637367/pexels-photo-25637367.jpeg",
                "assuredLabel": "Cars24 Owned stock",
                "name": "2016 Hyundai Creta",
                "variant": "SX PLUS 1.6 PETROL",
                "specs": [
                  "72,971 km",
                  "Petrol",
                  "Manual",
                  "GJ01"
                ],
                "price": "₹5.21 lakh",
                "priceValue": 521000,
                "emi": "EMI ₹11,598/m*",
                "footnote": "+other charges",
                "badges": [
                  "Zero Worry Max",
                  "Lifetime warranty"
                ],
                "wishlisted": false,
                "carId": "creta2016"
              },
              {
                "id": "car_baleno",
                "imageUrl": "https://images.pexels.com/photos/26834313/pexels-photo-26834313.jpeg",
                "assuredLabel": "Cars24 Owned stock",
                "name": "2021 Maruti Baleno",
                "variant": "ZETA PETROL 1.2",
                "specs": [
                  "20,518 km",
                  "Petrol",
                  "Manual",
                  "GJ05"
                ],
                "price": "₹4.76 lakh",
                "priceValue": 476000,
                "emi": "EMI ₹10,602/m*",
                "footnote": "+other charges",
                "badges": [
                  "Zero Worry Max",
                  "Lifetime warranty"
                ],
                "wishlisted": false,
                "carId": "baleno2021"
              }
            ]
          },
          {
            "id": "love_rail_hot",
            "type": "lazy_row",
            "visibleWhen": {
              "state": "carsFilter",
              "equals": "hot"
            },
            "style": {
              "padding": {
                "start": 20,
                "top": 12,
                "end": 20,
                "bottom": 0
              },
              "itemSpacing": 12
            },
            "template": {
              "type": "car_card",
              "props": {
                "imageUrl": "@{item.imageUrl}",
                "assuredLabel": "@{item.assuredLabel}",
                "name": "@{item.name}",
                "variant": "@{item.variant}",
                "specs": "@{item.specs}",
                "price": "@{item.price}",
                "priceValue": "@{item.priceValue}",
                "emi": "@{item.emi}",
                "footnote": "@{item.footnote}",
                "badges": "@{item.badges}",
                "wishlisted": "@{item.wishlisted}",
                "stateKey": "wishlist_@{item.carId}"
              },
              "actions": {
                "onClick": {
                  "type": "sequence",
                  "actions": [
                    {
                      "type": "track",
                      "payload": {
                        "event": "car_click",
                        "id": "@{item.carId}"
                      }
                    },
                    {
                      "type": "navigate",
                      "payload": {
                        "route": "car_detail",
                        "params": {
                          "carId": "@{item.carId}"
                        }
                      }
                    }
                  ]
                },
                "onEmiClick": {
                  "type": "open_sheet",
                  "payload": {
                    "sheetId": "emi_breakup"
                  }
                },
                "onWishlistSelect": {
                  "type": "sequence",
                  "actions": [
                    {
                      "type": "track",
                      "payload": {
                        "event": "wishlist_add",
                        "id": "@{item.carId}"
                      }
                    },
                    {
                      "type": "set_state",
                      "payload": {
                        "key": "wishlist_@{item.carId}",
                        "value": "true"
                      }
                    },
                    {
                      "type": "show_snackbar",
                      "payload": {
                        "message": "Car added to favourite list"
                      }
                    }
                  ]
                },
                "onWishlistUnselect": {
                  "type": "sequence",
                  "actions": [
                    {
                      "type": "track",
                      "payload": {
                        "event": "wishlist_remove",
                        "id": "@{item.carId}"
                      }
                    },
                    {
                      "type": "set_state",
                      "payload": {
                        "key": "wishlist_@{item.carId}",
                        "value": "false"
                      }
                    },
                    {
                      "type": "show_snackbar",
                      "payload": {
                        "message": "Car removed from favourite list"
                      }
                    }
                  ]
                }
              }
            },
